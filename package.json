{
  "name": "trace-kit",
  "private": true,
  "version": "0.0.10",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "description": "High-throughput, headless telemetry and physical signal visualization engine for mission-critical hardware characterization and semiconductor wafer yield analytics.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelomr/trace-kit.git"
  },
  "license": "MIT",
  "author": "Nelo Martinez",
  "scripts": {
    "build": "pnpm exec turbo run build",
    "test": "pnpm exec turbo run test",
    "test:unit": "pnpm exec turbo run test:unit",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "pnpm exec turbo run lint",
    "prepare": "husky",
    "change": "node scripts/add-changeset.mjs",
    "check:freshness": "node scripts/check-dependency-freshness.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "turbo": "2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
