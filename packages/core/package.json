{
  "name": "@trace-kit/core",
  "version": "0.0.9",
  "description": "High-throughput isomorphic telemetry & decimation engine",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project core",
    "lint": "eslint .",
    "bench": "tsx bench/index.ts",
    "bench:deopt": "tsx bench/index.ts --trace-deopt",
    "bench:ownership": "node --expose-gc --trace-gc bench/ownership-prototype.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "tsx": "catalog:",
    "fast-check": "catalog:"
  }
}
