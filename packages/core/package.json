{
  "name": "@trace-kit/core",
  "version": "0.0.3",
  "description": "High-throughput isomorphic telemetry & decimation engine",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "bench": "tsx bench/index.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "tsx": "catalog:"
  }
}
