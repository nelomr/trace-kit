{
  "name": "@trace-kit/renderers",
  "version": "0.0.5",
  "description": "Headless Canvas2D/WebGL2 figure renderers for trace-kit",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./font": {
      "types": "./dist/font/index.d.ts",
      "import": "./dist/font/index.js",
      "require": "./dist/font/index.cjs"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "import": "./dist/svg/index.js",
      "require": "./dist/svg/index.cjs"
    },
    "./webgl2": {
      "types": "./dist/webgl2/index.d.ts",
      "import": "./dist/webgl2/index.js",
      "require": "./dist/webgl2/index.cjs"
    },
    "./fixtures": {
      "types": "./dist/fixtures/scenarios.d.ts",
      "import": "./dist/fixtures/scenarios.js",
      "require": "./dist/fixtures/scenarios.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.svg-dts.json",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project renderers --project renderers-dom",
    "test:update-svg-goldens": "TRACEKIT_UPDATE_SVG_GOLDENS=1 vitest run --config ../../vitest.config.ts --project renderers svg-golden",
    "test:visual": "vitest run --config ../../vitest.config.ts --project visual",
    "bench:engines": "vitest run --config ../../vitest.config.ts --project engine-bench",
    "lint": "eslint ."
  },
  "dependencies": {
    "@trace-kit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "happy-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "pixelmatch": "catalog:"
  }
}
