{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:unit": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "//#lint": {
      "dependsOn": [],
      "inputs": [
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "package.json",
        "scripts/verify-catalog-discipline.mjs",
        "scripts/verify-no-root-exports.mjs",
        "packages/*/package.json",
        "packages/*/tsconfig.json",
        "apps/*/package.json",
        "apps/*/tsconfig.json"
      ]
    }
  }
}
