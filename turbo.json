{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build", "test:visual"]
    },
    "test:unit": {
      "dependsOn": []
    },
    "test:visual": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "test/visual/**",
        "../../vitest.config.ts",
        "../../pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
